# Строка подключения к Postgres (Vercel Postgres / Neon / Supabase — любая совместимая БД)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Для миграций на некоторых провайдерах (например Vercel Postgres) нужна отдельная
# строка без pgbouncer — если провайдер её не даёт, можно использовать DATABASE_URL
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Сгенерировать: openssl rand -base64 32
NEXTAUTH_SECRET="paste-generated-secret-here"

# Локально — http://localhost:3000, на проде — https://ваш-проект.vercel.app
NEXTAUTH_URL="http://localhost:3000"
